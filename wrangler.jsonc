// Cloudflare Workers: serves the built apps/web as static assets (no Worker script).
// Build with `pnpm build` at the repository root before `wrangler deploy`.
{
  "name": "mend",
  "compatibility_date": "2026-11-01",
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "./apps/web/dist",
  },
  // Required by `wrangler preview` (the deploy command for non-production branches).
  "previews": {},
}
